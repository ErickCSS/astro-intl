{
  "name": "astro-intl-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "pnpm --filter astro-intl test",
    "lint": "pnpm --filter astro-intl lint",
    "build": "pnpm --filter astro-intl build",
    "pack:check": "pnpm --filter astro-intl pack:check",
    "compat:check": "node scripts/compat-check.mjs",
    "audit:prod": "node scripts/dependency-audit.mjs",
    "consumers:check": "pnpm --dir docs/playground build && pnpm --dir docs/astro-intl-i18n build",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm pack:check && pnpm docs:check && pnpm consumers:check"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0"
    }
  }
}
