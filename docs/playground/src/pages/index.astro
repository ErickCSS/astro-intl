---
import AutoRedirect from "astro-intl/components";
import { routing } from "../i18n/routing";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>astro-intl — Type-safe i18n for Astro</title>
    <meta
      name="description"
      content="Type-safe internationalization library for Astro. Redirecting to your language..."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/logo-astro-intl.svg" />
    <style>
      html { color-scheme:dark; background:#1c1c1c; color:#f3f2ed; font-family:system-ui,sans-serif; }
      body { min-height:95vh; display:grid; place-content:center; text-align:center; }
      a { color:#7cd59c; margin:.5rem; }
    </style>
    <AutoRedirect locales={[...routing.locales]} defaultLocale={routing.defaultLocale} />
  </head>
  <body>
    <main>
      <h1>astro-intl</h1>
      {routing.locales.map(code => <a href={"/" + code} lang={code} hreflang={code}>{routing.labels[code]}</a>)}
    </main>
  </body>
</html>
