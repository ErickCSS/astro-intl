---
import { getLocale, getTranslations } from "astro-intl";
import Hero from "@astro-intl/docs-ui/HomeHero.astro";
import InstallTabs from "../InstallTabs.astro";
const t = getTranslations("hero");
---
<Hero
  locale={getLocale()}
  title={t("title")}
  titleAccent={t("titleAccent")}
  subtitle={t("subtitle")}
  description={t.markup("description", { bold: (text: string) => "<strong>" + text + "</strong>" })}
  action={t("getStarted")}
>
  <InstallTabs pkg="astro-intl" />
</Hero>
