---
import { getLocale, switchLocalePath } from "astro-intl";
import { routing } from "@/i18n/routing";
import LanguageMenu from "@astro-intl/docs-ui/LanguageMenu.astro";
const current = getLocale();
const links = routing.locales.map(code => ({
  code, label: routing.labels[code],
  href: switchLocalePath(Astro.url.pathname, code),
}));
---
<LanguageMenu current={current} links={links} />
