---
import CodeBlock from "../CodeBlock.astro";
import { getLocale, getTranslations } from "astro-intl";
import { guideLabels } from "../../../../shared/doc-guides.mjs";

const t = getTranslations("docs");
const locale = getLocale() === "es" ? "es" : "en";

const functions = [
  {
    key: "setRequestLocale",
    type: "function",
  },
  {
    key: "runWithLocale",
    type: "function",
  },
  {
    key: "getLocale",
    type: "function",
  },
  {
    key: "getTranslations",
    type: "function",
  },
  {
    key: "defineRequestConfig",
    type: "function",
  },
  {
    key: "getLocales",
    type: "function",
  },
  {
    key: "isValidLocale",
    type: "function",
  },
  {
    key: "getMessages",
    type: "function",
  },
  {
    key: "createIntlMiddleware",
    type: "function",
  },
  {
    key: "path",
    type: "function",
  },
  {
    key: "switchLocalePath",
    type: "function",
  },
  {
    key: "requestConfig",
    type: "type",
  },
  {
    key: "intlConfig",
    type: "type",
  },
  {
    key: "primitive",
    type: "type",
  },
  {
    key: "dotPaths",
    type: "type",
  },
  {
    key: "routesMap",
    type: "type",
  },
  {
    key: "createGetTranslationsReact",
    guide: "react",
    type: "function",
  },
  {
    key: "createGetTranslationsPreact",
    guide: "preact",
    type: "function",
  },
  {
    key: "createGetTranslationsSolid",
    guide: "solid",
    type: "function",
  },
  {
    key: "createGetTranslationsVue",
    guide: "vue",
    type: "function",
  },
  {
    key: "createGetTranslationsSvelte",
    guide: "svelte",
    type: "function",
  },
  {
    key: "renderRichText",
    guide: "svelte",
    type: "function",
  },
  {
    key: "getFallbackRoutes",
    type: "function",
  },
  {
    key: "fallbackRouteInfo",
    type: "type",
  },
  {
    key: "tRaw",
    type: "type",
  },
  {
    key: "messagesDirConfig",
    type: "type",
  },
  {
    key: "autoRedirect",
    type: "function",
  },
  {
    key: "autoDetectLocale",
    type: "type",
  },
] as const;
---

<section id="api" class="mb-14 scroll-mt-24">
  <div class="flex items-center gap-3 mb-8">
    <span class="w-1 h-5 rounded-full" style="background: var(--color-accent);"></span>
    <h1 class="text-xl font-bold" style="color: var(--color-text);">{t("api.title")}</h1>
  </div>

  <div class="space-y-4">
    {
      functions.map((fn) => (
        <div class="rounded-xl overflow-hidden" style="border: 1px solid var(--color-border);">
          <div
            class="flex items-center gap-3 px-5 py-4"
            style="background: var(--color-bg-card); border-bottom: 1px solid var(--color-border);"
          >
            <span
              class="text-xs font-semibold px-2 py-0.5 rounded-full"
              style={
                fn.type === "function"
                  ? "background: rgba(111,207,151,0.15); color: var(--color-accent);"
                  : "background: rgba(111,207,151,0.08); color: var(--color-stone); border: 1px solid var(--color-border-hover);"
              }
            >
              {fn.type}
            </span>
            <code
              class="text-sm font-semibold"
              style="background: transparent; border: none; padding: 0; color: var(--color-text);"
            >
              {t(`api.${fn.key}.name` as any)}
            </code>
            {(fn as any).deprecated && (
              <span
                class="text-xs px-2 py-0.5 rounded-full font-medium"
                style="background: rgba(251,191,36,0.15); color: #fbbf24;"
              >
                Deprecated
              </span>
            )}
          </div>

          <div class="px-5 py-4" style="background: var(--color-bg-secondary);">
            {fn.type === "function" && (
              <div class="mb-3">
                <CodeBlock lang="typescript" code={t(`api.${fn.key}.signature` as any)} />
              </div>
            )}
            <p
              class="text-sm leading-relaxed"
              style="color: var(--color-text-secondary);"
              set:html={t.markup(`api.${fn.key}.description` as any, {
                code: (c: string) => `<code>${c}</code>`,
              })}
            />
            {"guide" in fn && (
              <a class="mt-2 inline-block text-sm underline" href={`/${locale}/docs/${fn.guide}`}>
                {guideLabels[locale][fn.guide]}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
