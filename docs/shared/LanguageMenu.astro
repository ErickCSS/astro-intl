---
interface Props {
  current: string;
  links: { code: string; href: string; label: string }[];
}
const { current, links } = Astro.props;
---
<details class="language-menu">
  <summary aria-label={current === "es" ? "Idioma del sitio" : "Site language"}>
    <span class={current === "es" ? "fi fi-do" : "fi fi-us"}></span>
    {current.toUpperCase()} <span aria-hidden="true">⌄</span>
  </summary>
  <ul>
    {links.map(({ code, href, label }) => <li><a href={href} lang={code} hreflang={code} aria-current={code === current ? "true" : undefined}>{label}</a></li>)}
  </ul>
</details>
<style>
  details { position:relative; font-size:.85rem; }
  summary { display:flex; align-items:center; gap:.45rem; list-style:none; cursor:pointer; padding:.4rem .65rem; color:var(--color-text-secondary); border:1px solid var(--color-border); border-radius:.4rem; }
  summary::-webkit-details-marker { display:none; }
  ul { position:absolute; z-index:50; right:0; top:calc(100% + .45rem); padding:.25rem; min-width:8rem; border:1px solid var(--color-border); border-radius:.4rem; background:var(--color-bg-card); box-shadow:0 .5rem 1.5rem #0005; }
  a { display:block; padding:.45rem .6rem; color:var(--color-text-secondary); border-radius:.25rem; }
  a:hover { background:var(--color-bg-hover); }
  a[aria-current] { color:var(--color-accent); }
</style>
<script>
  document.addEventListener("click", event => {
    const menu = document.querySelector<HTMLDetailsElement>(".language-menu[open]");
    if (!menu) return;
    if (!menu.contains(event.target as Node)) menu.open = false;
    const link = (event.target as Element).closest<HTMLAnchorElement>(".language-menu a");
    if (link) { link.search = location.search; link.hash = location.hash; }
  }, { capture: true });
  document.addEventListener("keydown", event => {
    const menu = document.querySelector<HTMLDetailsElement>(".language-menu[open]");
    if (event.key === "Escape" && menu) { menu.open = false; menu.querySelector("summary")?.focus(); }
  });
</script>
