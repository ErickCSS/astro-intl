---
import { getLocale } from "astro-intl";
import SEO from "@/components/SEO.astro";
import "flag-icons/css/flag-icons.min.css";
import Analytics from "@vercel/analytics/astro";

const locale = getLocale();

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  image?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title = "Astro-intl — Simple and powerful i18n for Astro",
  description = "Type-safe internationalization library for Astro. Build multilingual websites with no props drilling, dynamic loading, namespaces support, and rich text formatting.",
  type = "website",
  image,
  keywords = [],
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEO
      title={title}
      description={description}
      type={type}
      image={image}
      keywords={keywords}
      noindex={noindex}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
