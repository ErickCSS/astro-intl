---
import {routing} from '../i18n/routing';
const locales=[...routing.locales],DEFAULT_LOCALE=routing.defaultLocale;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><title>astro-intl — Choose your language</title><script define:vars={{locales,DEFAULT_LOCALE}}>const lang=navigator.language.slice(0,2).toLowerCase();location.replace('/'+(locales.includes(lang)?lang:DEFAULT_LOCALE));</script></head><body><main><h1>astro-intl</h1><a href="/en">English</a> · <a href="/es">Español</a></main></body></html>
