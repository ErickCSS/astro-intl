---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { getLocale } from "astro-intl";
import { guideGroups, guideLabels } from "../../../../../shared/doc-guides.mjs";
const locale = getLocale() === "es" ? "es" : "en";
const labels = guideLabels[locale];
const base = `/${locale}/docs`;
export function getStaticPaths() { return [{ params: { lang: "en" } }, { params: { lang: "es" } }]; }
---
<DocsLayout>
  <h1 class="text-3xl font-bold mb-4" style="color: var(--color-text);">{labels.overview}</h1>
  <p class="mb-8 leading-relaxed" style="color: var(--color-text-secondary);">{locale === "es" ? "Empieza con una página en dos idiomas. Después aprende a organizar los mensajes y consulta las guías avanzadas cuando tu proyecto las necesite." : "Start with one page in two languages. Then learn to organize messages and use advanced guides when your project needs them."}</p>
  <a href={`${base}/quick-start`} class="block rounded-xl p-6 mb-10" style="background: var(--color-accent-dim); border: 1px solid var(--color-border-hover);">
    <span class="text-sm" style="color: var(--color-accent);">{labels.start}</span>
    <h2 class="text-2xl font-bold mt-2 mb-2" style="color: var(--color-text);">{labels["quick-start"]} →</h2>
    <p style="color: var(--color-text-secondary);">{locale === "es" ? "Desde un proyecto Astro existente hasta ver Hola en /es/ y Hello en /en/. Todos los archivos y pasos en una sola guía." : "From an existing Astro project to Hola at /es/ and Hello at /en/. Every file and step in one guide."}</p>
  </a>
  {guideGroups.slice(1).map(group => <section class="mb-8">
    <h2 class="text-lg font-semibold mb-3" style="color: var(--color-text);">{labels[group.label as keyof typeof labels]}</h2>
    <ul class="grid sm:grid-cols-2 gap-3">{group.pages.map(page => <li><a id={page} href={`${base}/${page}`} class="block p-4 rounded-lg underline" style="border: 1px solid var(--color-border); color: var(--color-accent);">{labels[page as keyof typeof labels]}</a></li>)}</ul>
  </section>)}
</DocsLayout>
