---
import {getLocale} from 'astro-intl';
interface Props{activePage?:'home'|'docs'|'changelog'}
const {activePage='home'}=Astro.props;const loc=getLocale(),es=loc==='es',other=es?'en':'es';const links=[['home',es?'Inicio':'Overview',`/${loc}`],['docs',es?'Documentación':'Documentation',`/${loc}/docs`],['changelog',es?'Novedades':'Changelog',`/${loc}/changelog`]];
---
<header class="mast"><div class="shell bar"><a class="brand" href={`/${loc}`}><svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg><span>astro<strong>-intl</strong></span></a><nav aria-label={es?'Principal':'Main'}>{links.map(([id,label,url])=><a href={url} aria-current={id===activePage?'page':undefined}>{label}</a>)}</nav><div class="tools"><a class="lang" href={Astro.url.pathname.replace(/^\/(en|es)/,`/${other}`)} aria-label={es?'Switch to English':'Cambiar a español'}>{loc.toUpperCase()} / {other.toUpperCase()}</a><a class="npm" href="https://www.npmjs.com/package/astro-intl" target="_blank" rel="noopener noreferrer">npm ↗</a></div></div></header>
<style>.mast{position:sticky;top:0;z-index:35;background:var(--color-bg);border-bottom:1px solid var(--color-border)}.bar{display:flex;align-items:center;justify-content:space-between;min-height:70px;gap:25px}.brand{display:flex;align-items:center;gap:9px;font-size:24px;letter-spacing:-.075em;font-weight:700;color:var(--color-text)}.brand{letter-spacing:-.045em}.brand strong{color:var(--color-accent)}.brand svg{background:var(--color-accent-dim);border:1px solid var(--color-border-hover);border-radius:7px;padding:6px;color:var(--color-accent)}nav,.tools{display:flex;align-items:center;gap:24px}nav a,.lang{font-size:14px;color:var(--color-text-secondary)}nav a[aria-current]{color:var(--color-accent)}.tools{gap:16px}.lang{font:12px var(--site-mono)}.npm{font:bold 15px var(--site-mono);color:var(--color-accent);border:1px solid var(--color-border-hover);background:var(--color-accent-dim);padding:8px 13px;border-radius:6px}.npm:hover{color:white;background:var(--color-accent)}@media(max-width:700px){.bar{flex-wrap:wrap;gap:0;padding-top:10px}.tools{margin-left:auto}.bar nav{order:3;width:100%;justify-content:space-between;padding:9px 0}.brand{font-size:21px}}</style>
