---
import {getLocale,getTranslations} from 'astro-intl';
const locale=getLocale(),es=locale==='es',t=getTranslations('features');
const cards=[['typeSafe','TS','usage'],['dynamicLoading','↯','message-loading'],['namespaces','{ }','configuration'],['noPropsDrilling','⌁','middleware'],['richText','</>','rich-text'],['simple','ƒ','api']];
---
<div class="stack"><div class="shell stack-in"><span>{es?'COMPATIBLE CON':'WORKS WITH'}</span>{[['Astro','astro-icon-dark','quick-start'],['React','react_dark','react'],['Svelte','svelte','svelte']].map(([name,img,path])=><a href={`/${locale}/docs/${path}`}><img src={`/Frameworks/${img}.svg`} alt="" width="23" height="23"/>{name}</a>)}<span class="license">MIT {es?'· Código abierto':'· Open source'}</span></div></div>
<section id="features" class="shell features"><div class="kicker"><b></b>{es?'LA LIBRERÍA':'THE TOOLKIT'}</div><div class="heading"><h2>{es?'Lo esencial para tu sitio multilingüe.':'Built for multilingual Astro.'}</h2><a href={`/${locale}/docs`}>{es?'Explorar documentación':'Explore the docs'} →</a></div><div class="feature-grid">{cards.map(([key,icon,slug])=><a href={`/${locale}/docs/${slug}`}><div class="glyph">{icon}</div><h3>{t(`${key}.title` as any)}</h3><p>{t(`${key}.description` as any)}</p><span class="arr">↗</span></a>)}</div></section>
<style>.stack{border-block:1px solid var(--color-border);background:var(--color-bg-secondary)}.stack-in{display:flex;align-items:center;gap:clamp(18px,3vw,50px);min-height:74px}.stack-in>span,.kicker{font:11px var(--site-mono);letter-spacing:.1em;color:var(--color-text-tertiary)}.stack-in a{display:flex;align-items:center;gap:8px;color:var(--color-text);font-size:18px;font-weight:600;letter-spacing:-.04em}.stack img{filter:grayscale(1);object-fit:contain;width:22px;height:24px}.stack-in .license{margin-left:auto;letter-spacing:0}.features{padding-block:64px 32px}.kicker{display:flex;align-items:center;gap:9px;color:var(--color-accent)}.kicker b{display:block;width:22px;height:2px;background:currentColor}.heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:12px 0 26px}.heading h2{font-size:clamp(28px,3.1vw,44px);line-height:1.13;font-weight:560;letter-spacing:-.065em}.heading a{font-size:14px}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.feature-grid>a{border:1px solid var(--color-border);border-radius:9px;padding:23px;position:relative;transition:background .2s}.feature-grid>a:hover{background:var(--color-bg-secondary)}.arr{position:absolute;right:20px;top:19px;color:var(--color-text-tertiary)}.glyph{font:600 17px var(--site-mono);border-radius:6px;background:var(--color-accent-dim);color:var(--color-accent);width:34px;height:34px;display:grid;place-items:center}.feature-grid h3{font-size:19px;color:var(--color-text);font-weight:600;margin:16px 0 5px;letter-spacing:-.04em}.feature-grid p{color:var(--color-text-secondary);font-size:14px;line-height:1.55}@media(max-width:700px){.feature-grid{grid-template-columns:1fr}.stack-in{flex-wrap:wrap;gap:16px;padding-block:16px}.stack-in .license{display:none}.stack-in a{font-size:15px}.heading{display:block}.heading a{display:block;margin-top:12px}.features{padding-block:40px}}</style>
