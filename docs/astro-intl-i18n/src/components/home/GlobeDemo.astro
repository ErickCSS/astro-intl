---
import {getLocale} from 'astro-intl';
const es=getLocale()==='es'; const demos=[['EN','Hello, world!','English'],['ES','¡Hola, mundo!','Español'],['FR','Bonjour, monde !','Français'],['JA','こんにちは、世界！','日本語']]; const idx=es?1:0;
---
<figure class="world-panel">
<header><span><b aria-hidden="true">&lt;/&gt;</b> {es?'LABORATORIO DE IDIOMAS':'LOCALE PLAYGROUND'}</span><small><i></i> {es?'En vivo':'Live demo'}</small></header>
<div class="canvas"><img src="/globe.webp" width="800" height="800" fetchpriority="high" alt=""/><div class="marker m-one">+ </div><div class="marker m-two">+ </div><span class="locale-tag"><i></i> <span id="demo-code">{demos[idx][0].toLowerCase()}</span>.json</span><output aria-live="polite">{demos[idx][1]}</output></div>
<footer><span class="code-expr">t(<b>'hello'</b>)</span><div class="switches" aria-label={es?'Idioma de demostración':'Demo language'}>{demos.map(([code,text,name],i)=><button aria-label={name} aria-pressed={idx===i} data-text={text} data-locale={code.toLowerCase()}>{code}</button>)}</div></footer>
</figure>
<script>
const panel=document.querySelector('.world-panel')!;panel.querySelectorAll<HTMLButtonElement>('[data-locale]').forEach(btn=>btn.addEventListener('click',()=>{panel.querySelectorAll('[data-locale]').forEach(el=>el.setAttribute('aria-pressed',String(el===btn)));const out=panel.querySelector('output')!;out.textContent=btn.dataset.text!;panel.querySelector('#demo-code')!.textContent=btn.dataset.locale!;if(!matchMedia('(prefers-reduced-motion: reduce)').matches)out.animate([{opacity:.4,translate:'0 4px'},{opacity:1,translate:'0 0'}],{duration:220})}));
</script>
<style>
.world-panel{border:1px solid var(--color-border);border-radius:13px;overflow:hidden;background:var(--color-bg);box-shadow:0 7px 22px #15193008;min-width:0}.world-panel header,.world-panel footer{display:flex;align-items:center;justify-content:space-between;padding:15px 19px}.world-panel header{border-bottom:1px solid var(--color-border);font:10px var(--site-mono);letter-spacing:.1em}.world-panel header span,.world-panel small,.locale-tag{display:flex;align-items:center;gap:8px}.world-panel header b{font-size:17px;color:var(--color-accent)}.world-panel small{font:11px var(--site-mono);letter-spacing:0}.world-panel i{width:6px;height:6px;background:var(--color-accent);border-radius:50%}.canvas{position:relative;isolation:isolate;overflow:hidden;display:grid;place-items:center;height:clamp(270px,23vw,350px);background-color:var(--color-bg-secondary);background-image:linear-gradient(#6fcf970b 1px,transparent 1px),linear-gradient(90deg,#6fcf970b 1px,transparent 1px);background-size:24px 24px}.canvas img{height:115%;width:auto;max-width:none;object-fit:contain;position:absolute;opacity:.9;z-index:-1}.marker{position:absolute;font:20px var(--site-mono);color:var(--color-stone)}.m-one{top:9px;left:12px}.m-two{right:12px;bottom:8px}.locale-tag{position:absolute;top:23%;right:9%;background:var(--color-bg-card);color:var(--color-text);border:1px solid var(--color-border);border-radius:4px;padding:4px 8px;gap:0;font:11px var(--site-mono)}.locale-tag i{margin-right:6px}output{background:var(--color-accent);color:var(--color-bg);border-radius:7px;box-shadow:4px 5px 0 var(--color-bg);transform:rotate(-5deg);padding:5px 17px 8px;font-size:clamp(25px,2.6vw,39px);font-weight:600;letter-spacing:-.06em}.world-panel footer{border-top:1px solid var(--color-border);padding-block:11px}.switches{display:flex;gap:4px}.switches button{font:11px var(--site-mono);cursor:pointer;border-radius:4px;padding:6px 9px;color:var(--color-text-tertiary)}.switches button[aria-pressed=true]{background:var(--color-accent);color:var(--color-bg)}.code-expr{font:13px var(--site-mono)}.code-expr b{color:var(--color-accent);font-weight:normal}
</style>
