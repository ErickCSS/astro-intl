---
import { getLocale } from 'astro-intl';
import GlobeDemo from './GlobeDemo.astro';
const locale = getLocale(), es = locale === 'es';
---
<section class="hero shell">
 <div class="intro">
  <a class="release" href={`/${locale}/changelog`}><i></i> v2.3 <span>/</span> {es ? 'Novedades' : 'Release notes'} ↗</a>
  <h1>{es ? 'i18n para Astro,' : 'i18n for Astro,'}<em>{es ? 'sin fricción.' : 'zero friction.'}</em></h1>
  <p>{es ? 'Internacionalización con tipado seguro, hecha para Astro. Lleva tu sitio a otros idiomas sin complicar tu código.' : 'Type-safe internationalization, built for Astro. Bring your site to every language without the complexity.'}</p>
  <div class="actions"><a class="primary" href={`/${locale}/docs/quick-start`}>{es ? 'Primeros pasos' : 'Get started'} <span>→</span></a><a class="secondary" href={`/${locale}/docs`}><svg viewBox="0 0 24 24" width="17" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 6C9 4 5 4 2 5v14c3-1 7-1 10 1 3-2 7-2 10-1V5c-3-1-7-1-10 1zm0 0v14"/></svg>{es ? 'Documentación' : 'Documentation'}</a></div>
  <button class="install" data-copied={es?'Copiado':'Copied'} aria-label={es?'Copiar comando de instalación':'Copy install command'}><b>$</b> npx astro add astro-intl <svg viewBox="0 0 24 24" width="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 5V3H4v13h2"/></svg></button><span class="sr-only" aria-live="polite" id="install-status"></span>
 </div><GlobeDemo />
</section>
<script>
 import gsap from 'gsap';
 if(!matchMedia('(prefers-reduced-motion: reduce)').matches) gsap.from('.intro > *, .world-panel', {y:16, opacity:0, duration:.65, stagger:.055, ease:'power2.out', clearProps:'all'});
 const copy=document.querySelector<HTMLButtonElement>('.install');copy?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('npx astro add astro-intl');copy.dataset.done='true';document.querySelector('#install-status')!.textContent=copy.dataset.copied!;setTimeout(()=>delete copy.dataset.done,1700)}catch{document.querySelector('#install-status')!.textContent='npx astro add astro-intl'}});
</script>
<style>
.hero{display:grid;grid-template-columns:1.07fr 1fr;align-items:center;gap:6%;padding-block:clamp(3.5rem,6.2vw,6rem)}.release{display:inline-flex;align-items:center;gap:9px;font:12px var(--site-mono);background:var(--color-bg-secondary);border:1px solid var(--color-border);border-radius:20px;padding:5px 11px;color:var(--color-text)}.release i{width:7px;height:7px;border-radius:100%;background:var(--color-accent)}.release span{opacity:.3}.intro h1{font-size:clamp(58px,6.8vw,104px);letter-spacing:-.055em;line-height:1.04;margin:25px 0 22px;font-weight:700}.intro em{display:block;font:inherit;color:var(--color-accent)}.intro p{max-width:460px;font-size:clamp(16px,1.3vw,20px);line-height:1.55;color:var(--color-text-secondary)}.actions{display:flex;gap:10px;margin:27px 0 20px;flex-wrap:wrap}.actions a{display:flex;align-items:center;gap:10px;border-radius:7px;padding:12px 17px;font-size:14px;font-weight:600;transition:transform .2s}.actions a:hover{transform:translateY(-2px)}.primary{background:var(--color-accent);color:var(--color-bg)}.secondary{border:1px solid var(--color-border);color:var(--color-text)}.install{position:relative;font:13px var(--site-mono);display:inline-flex;align-items:center;gap:11px;border:1px solid var(--color-border);border-radius:6px;padding:10px 12px;background:var(--color-bg-secondary);cursor:pointer}.install b{color:var(--color-accent)}.install svg{margin-left:15px}.install[data-done=true]:after{content:attr(data-copied);background:var(--color-text);color:white;padding:4px 8px;border-radius:4px;position:absolute;left:100%;margin-left:4px}@media(max-width:790px){.hero{grid-template-columns:1fr;gap:32px;padding-block:40px}.intro h1{font-size:clamp(58px,10vw,78px)}}
</style>
