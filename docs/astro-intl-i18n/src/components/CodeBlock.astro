---
import { getLocale } from "astro-intl";
import CodeExample from "@astro-intl/docs-ui/CodeExample.astro";
interface Props { code: string; lang?: string; title?: string; }
const { code, lang = "typescript", title = lang } = Astro.props;
---
<CodeExample locale={getLocale()} files={[{ label: title, lang, code }]} />
